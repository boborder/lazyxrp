/target

# Secrets — never commit real seeds or keys
.env
.env.*
!.env.example

graphify-out
.codegraph

# OpenSpec — local agent workflow, not published
openspec/*
!openspec/config.yaml

# Local agent / harness state (not part of the product)
.pi/
.atl/
.scratch/
./agents/
.config/lazyxrp-test/*
!.config/lazyxrp-test/config.toml.example

# Flare skill scratch scripts (local probes)
.agents/skills/flare-fassets/scripts/_*.ts
.agents/skills/flare-fassets/scripts/_*.json
