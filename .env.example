# lazyxrp does not load .env files. Export these values in your shell first.
# Optional for local shell use: copy to .env (gitignored), then run `set -a; . ./.env; set +a`.
# Never commit .env.
# XRPL_SEED=s...
# XRPL_MNEMONIC=abandon ... about
# allthatnode node
# https://docs.allthatnode.com/docs/getting-started-with-endpoints
# XRPL_RPC_SERVER=https://...
# XRPL_WS_SERVER=wss://...

# Flare executor key for FXRP C3 (only when [flare.fassets] execute=true)
# FLARE_EVM_KEY=0x...
